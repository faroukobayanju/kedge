{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "neatHack LiteLLM (Nova and Claude)",
      "options": {
        "baseURL": "https://litellm.vision.aivar.app/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "claude-sonnet-4.6": { "name": "Claude Sonnet 4.6", "cost": { "input": 3, "output": 15 } },
        "claude-haiku": { "name": "Claude Haiku", "cost": { "input": 1, "output": 5 } },
        "claude-opus-4.6": { "name": "Claude Opus 4.6", "cost": { "input": 5, "output": 25 } },
        "nova-pro": { "name": "Amazon Nova Pro", "cost": { "input": 0.8, "output": 3.2 } },
        "nova-lite": { "name": "Amazon Nova Lite", "cost": { "input": 0.06, "output": 0.24 } }
      }
    }
  }
}
